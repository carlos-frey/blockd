[Unit]
Description=blockd — dnsmasq do sinkhole de DNS
Documentation=file:///usr/share/doc/blockd/README.md
After=network.target
Before=nss-lookup.target
# Só existe enquanto algum domínio está bloqueado (o blockd cria/remove o arquivo).
ConditionPathExists=/var/lib/blockd/dnsmasq.conf

[Service]
Type=simple
ExecStart=/usr/bin/dnsmasq --keep-in-foreground --conf-file=/var/lib/blockd/dnsmasq.conf
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
